APP_ENV=development

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=paper_ai
POSTGRES_USER=paper_ai
POSTGRES_PASSWORD=change-me

NEO4J_URI=bolt://neo4j:7687
